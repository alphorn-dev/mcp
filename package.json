{
  "name": "@alphorn/mcp",
  "version": "0.1.0",
  "description": "MCP server for Alphorn: lets AI agents send notifications to Slack, email, SMS, push, and other channels through Alphorn.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "bin": {
    "alphorn-mcp": "dist/index.js"
  },
  "files": [
    "dist/index.js",
    "dist/server.js"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "test": "pnpm build && node --test dist/*.test.js",
